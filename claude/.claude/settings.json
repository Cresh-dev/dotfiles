{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_COMMIT_REVIEW": "0",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "deniedMcpServers": [
    { "serverName": "claude.ai Notion" },
    { "serverName": "claude.ai Canva" },
    { "serverName": "claude.ai Microsoft 365" },
    { "serverName": "claude.ai SlickTrip" }
  ],
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(npm run lint *)",
      "Bash(npm run lint)",
      "Bash(npm run test *)",
      "Bash(npm run test)",
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest run *)",
      "Bash(pytest *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(shellcheck *)",
      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker system df)",
      "Bash(brew list *)",
      "Bash(brew info *)",
      "Bash(brew outdated *)",
      "Bash(mise ls *)",
      "Bash(memory_pressure)",
      "Bash(git -C /Users/alessio/dotfiles status *)",
      "Bash(git -C /Users/alessio/dotfiles add *)",
      "Bash(git -C /Users/alessio/dotfiles commit *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git -C * push*--force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push * +*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/config)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/**)",
      "Read(~/.zshrc.local)",
      "Read(~/.ollama/id_ed25519)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(npm publish *)",
      "Bash(brew install *)",
      "Bash(brew uninstall *)",
      "Bash(brew upgrade *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code ti sta aspettando\" with title \"Claude Code\" sound name \"Glass\"'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "legal@synced": false,
    "marketing@synced": false,
    "searchfit-seo@synced": false,
    "design@synced": false,
    "canva@synced": false,
    "productivity@synced": false,
    "data@synced": false,
    "engineering@synced": false,
    "remotion@synced": false
  },
  "language": "Italiano",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "rubygems.org",
        "*.rubygems.org",
        "proxy.golang.org",
        "sum.golang.org",
        "nodejs.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache",
        "~/Library/Caches",
        "~/.virtualenvs",
        "~/.local/share/mise",
        "~/.local/state/mise"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/.kube/config",
        "~/.netrc",
        "~/.npmrc",
        "~/.docker/config.json",
        "~/.config/gh",
        "~/.zshrc.local",
        "~/.ollama/id_ed25519"
      ]
    },
    "excludedCommands": [
      "docker *",
      "orbctl *",
      "brew *",
      "minikube *",
      "kind *",
      "kubectl *",
      "git push *",
      "git pull *",
      "git fetch *",
      "git clone *",
      "gh *",
      "ssh *"
    ]
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 400000
    }
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "auto",
  "voiceEnabled": true
}
