# Shared git config. Identity (name/email) lives in ~/.config/git/local,
# which is NOT tracked: this repo is public. See README.

[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = ansi

[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
	# More readable hunks when code blocks are moved around
	algorithm = histogram
[branch]
	sort = -committerdate
[tag]
	sort = version:refname

[alias]
	lg = log --graph --pretty=format:'%C(yellow)%h%C(reset) %C(blue)%ad%C(reset) %s%C(auto)%d %C(dim)— %an' --date=short
	st = status -sb

# Last, so machine-local values (identity) win
[include]
	path = ~/.config/git/local
