# Shared git config. Identity (name/email) lives in ~/.config/git/local,
# which is NOT tracked: this repo is public. See README.

[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = ansi

[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
	# More readable hunks when code blocks are moved around
	algorithm = histogram
[branch]
	sort = -committerdate
[tag]
	sort = version:refname

# Remember how a conflict was resolved and replay it next time
[rerere]
	enabled = true
[rebase]
	autoStash = true
# Show the diff below the message while writing it
[commit]
	verbose = true

# Sign with the SSH key already used for GitHub, no GPG needed.
# The key itself and commit.gpgsign live in ~/.config/git/local (see README).
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[alias]
	lg = log --graph --pretty=format:'%C(yellow)%h%C(reset) %C(blue)%ad%C(reset) %s%C(auto)%d %C(dim)— %an' --date=short
	st = status -sb

# Last, so machine-local values (identity) win
[include]
	path = ~/.config/git/local
