// Only non-default values live here: if a key is missing, VS Code's default is the choice.
{
  // ── Look ────────────────────────────────────────────────
  "workbench.colorTheme": "GitHub Dark Default",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 14,
  "workbench.tree.renderIndentGuides": "always",
  "window.title": "${rootName}${separator}${activeEditorShort}",

  // Same font as Ghostty, so editor and terminal look alike
  "editor.fontFamily": "'JetBrainsMono Nerd Font', Menlo, monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.fontLigatures": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.guides.bracketPairs": "active",
  "editor.stickyScroll.enabled": true,
  "editor.rulers": [88, 100],
  "editor.padding.top": 8,

  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,

  // ── Editing ─────────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.linkedEditing": true,
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // ── Formatter per language ──────────────────────────────
  // Prettier only where it is the right tool, not as a global default
  "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][css][scss][html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    // Two trailing spaces are a hard line break in Markdown
    "files.trimTrailingWhitespace": false,
    "editor.wordWrap": "on"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[yaml]": { "editor.defaultFormatter": "redhat.vscode-yaml" },
  "[toml]": { "editor.defaultFormatter": "tamasfe.even-better-toml" },
  "[c][cpp]": { "editor.defaultFormatter": "ms-vscode.cpptools" },

  // ── Performance (8 GB RAM) ──────────────────────────────
  // The file watcher and search walk these folders otherwise
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/_site/**": true,
    "**/public/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/_site": true,
    "**/public": true
  },

  // ── Git ─────────────────────────────────────────────────
  "git.autofetch": true,
  "git.blame.editorDecoration.enabled": true,
  "git.blame.statusBarItem.enabled": true,
  "git-graph.repository.commits.showSignatureStatus": true,

  // ── Python: Pylance types, ruff style ───────────────────
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  // A project's pyproject.toml / ruff.toml wins over editor settings
  "ruff.configurationPreference": "filesystemFirst",
  "jupyter.askForKernelRestart": false,

  // ── Markdown ────────────────────────────────────────────
  "markdownlint.config": {
    "MD013": false, // line length: notes wrap in the editor
    "MD033": false, // inline HTML: Quartz and Jekyll use it
    "MD025": false, // frontmatter title + H1 is normal in Quartz
    "MD041": false // files start with frontmatter, not a heading
  },
  "markdown.extension.toc.updateOnSave": false,

  // ── Other extensions ────────────────────────────────────
  "errorLens.messageMaxChars": 120,
  "errorLens.delay": 500,
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "material-icon-theme.hidesExplorerArrows": true,
  "material-icon-theme.files.associations": {
    "Brewfile": "ruby",
    "*.ghostty": "console",
    ".stowrc": "settings"
  },
  "rainbow_csv.enable_auto_csv_lint": false,
  "godotTools.editorPath.godot4": "/Applications/Godot.app/Contents/MacOS/Godot",
  // Use Homebrew's binaries instead of letting the extension download its own
  "vs-kubernetes": {
    "vs-kubernetes.kubectl-path.mac": "/opt/homebrew/bin/kubectl",
    "vs-kubernetes.minikube-path.mac": "/opt/homebrew/bin/minikube",
    "checkForMinikubeUpgrade": false,
    "vs-kubernetes.ignore-recommendations": true
  },
  "github.copilot.enable": { "*": false },
  "claudeCode.preferredLocation": "panel",

  // ── Privacy and noise ───────────────────────────────────
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "update.showReleaseNotes": false,
  "security.workspace.trust.untrustedFiles": "open",
  "terminal.integrated.allowedLinkSchemes": ["file", "http", "https", "mailto", "vscode"]
}
